PORT=5001
NODE_ENV=development
API_PREFIX=/api/v1
PUBLIC_API_URL=http://localhost:5001
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8081

MONGODB_URI=mongodb://127.0.0.1:27017/vedrit

JWT_SECRET=
JWT_EXPIRES_IN=30d

ADMIN_EMAIL=admin@vedrit.in
ADMIN_PASSWORD=

# Email OTP via Resend (https://resend.com). Verify the vedrit.in domain, then use e.g. VedRit <no-reply@vedrit.in>
RESEND_API_KEY=
EMAIL_FROM=VedRit <no-reply@vedrit.in>

# Mobile OTP via Fast2SMS. Leave empty in development: the code is returned by the API and logged.
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=

# Fixed code for reviewer / developer accounts (4-6 digits)
STATIC_OTP=
REVIEWER_PHONES=
REVIEWER_EMAILS=

# Developer test user (created by: npm run dev-user)
DEV_USER_NAME=VedRit Developer
DEV_USER_PHONE=9999999999
DEV_USER_EMAIL=dev@vedrit.in
DEV_USER_PASSWORD=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

GEMINI_API_KEY=
