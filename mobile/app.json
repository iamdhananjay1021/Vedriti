{
  "expo": {
    "name": "VedRiti",
    "slug": "vedriti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vedriti.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "VedRiti needs access to your camera to capture Kundli documents and Puja Sankalp details.",
        "NSPhotoLibraryUsageDescription": "VedRiti needs access to your photo library to upload Kundli documents.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.vedriti.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
